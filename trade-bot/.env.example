# Set to live only after the IBKR account is open, funded and authenticated.
TRADING_MODE=paper
SIGNAL_URL=https://raw.githubusercontent.com/girschen-crypto/Aweh-Kosher/main/trade-desk/signal.json

PAPER_STARTING_CASH=10000
PAPER_CURRENCY=USD
PAPER_LEDGER=paper_ledger.json

MAX_TRADE_PCT=5
MAX_SYMBOL_EXPOSURE_PCT=20
MAX_DAILY_LOSS_PCT=2
ALLOWED_TICKERS=BWXT,QCOM,AVAV

# LIVE MICRO MODE
# Default real-money order is USD 5 and the bot may never exceed USD 10 per BUY
# unless these values are deliberately changed.
LIVE_DEFAULT_ORDER_USD=5
LIVE_MAX_ORDER_USD=10
LIVE_MAX_ORDERS_PER_DAY=2
LIVE_STATE_FILE=live_state.json

# IBKR Web API / Client Portal Gateway
ENABLE_LIVE_ORDERS=NO
IBKR_BASE_URL=https://localhost:5000/v1/api
IBKR_ACCOUNT_ID=
IBKR_VERIFY_SSL=false
